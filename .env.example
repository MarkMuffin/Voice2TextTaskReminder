# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Database — absolute path recommended for Docker (avoids cwd ambiguity)
DATABASE_URL=sqlite+aiosqlite:////app/data/app.db

# LLM - OpenRouter
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# STT provider: mock | openai | groq
STT_PROVIDER=openai
STT_API_KEY=your_stt_api_key_here
STT_MODEL=whisper-1
STT_BASE_URL=https://api.openai.com/v1

# App settings
DEFAULT_TIMEZONE=Europe/Amsterdam
LOG_LEVEL=INFO

# /list render mode:
#   auto     — inline keyboard for regular chats, native checklist if bot is connected as Telegram Business
#   inline   — always inline keyboard (default for personal use)
#   business — native checklist only (requires Telegram Business subscription + bot connected as business bot)
TASK_LIST_RENDER_MODE=auto

# Recurring tasks
ENABLE_RECURRING_TASKS=true
RECURRING_TASK_GENERATOR_INTERVAL_SECONDS=60

# SQLite backup to Cloudflare R2 (disabled until all R2 values are configured)
ENABLE_DB_BACKUP_TO_R2=true
DB_BACKUP_INTERVAL_SECONDS=3600
DB_BACKUP_R2_ENDPOINT_URL=https://a4a85e56dae9d279ed5c9b5127088560.r2.cloudflarestorage.com
DB_BACKUP_R2_BUCKET=task-reminder-backup
DB_BACKUP_R2_ACCESS_KEY_ID=5cf9f61f6f68ec4b4e6bab65af6dac62
DB_BACKUP_R2_SECRET_ACCESS_KEY=b498f0ba7dec4ffab4aabecab4fd8b97720177adf47df40c0590bd43f745b7be
DB_BACKUP_R2_PREFIX=db-backups
DB_BACKUP_R2_REGION=auto
